    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run TUI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/tui/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "BUILDIT_STORAGE": "dump",
            },
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run TUI DB",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/tui/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "BUILDIT_STORAGE": "db",
            },
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "ImDearGui",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/impl/unknown.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "BUILDIT_STORAGE": "db",
            },
            "cwd": "${workspaceFolder}"
        },
    ]
}